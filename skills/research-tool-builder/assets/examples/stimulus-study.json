{
  "studyId": "pricing-page-reactions",
  "title": "Pricing page reactions",
  "version": 1,
  "brief": {
    "body": "You'll look at a few versions of a pricing page and answer short questions about each. Some appear only briefly. About 6 minutes.",
    "minutes": 6
  },
  "consent": {
    "notice": 1,
    "heading": "Before you begin",
    "text": "We record your answers, how long each task takes and anything you type. You are identified only by a code, never your name.\n\nYour answers stay on this device until the research team exports them, are used only for this study, and are deleted 90 days after it ends. You can stop at any time.",
    "items": [
      {
        "id": "data-notice",
        "label": "I've read how my answers will be used",
        "required": true
      },
      {
        "id": "over-18",
        "label": "I'm 18 or over",
        "required": true
      }
    ]
  },
  "segments": [
    {
      "id": "new",
      "label": "New to the product"
    },
    {
      "id": "customer",
      "label": "Current customer"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "At a glance, people can tell what the page is for and which plan is recommended."
    },
    {
      "id": "H2",
      "statement": "People prefer the layout with the recommended plan highlighted."
    },
    {
      "id": "H3",
      "statement": "The cancellation terms are understood without help."
    }
  ],
  "shuffleTasks": false,
